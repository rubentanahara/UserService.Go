meta {
  name: Create User
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/users
  body: json
  auth: none
}

body:json {
  {
    "username": "jane",
    "email": "jane@example.com",
    "password": "password123"
  }
}

script:post-response {
  if (res.body.id) {
    bru.setVar("userId", res.body.id);
  }
}

tests {
  test("returns 201", function () {
    expect(res.getStatus()).to.equal(201);
  });
  test("body has id", function () {
    expect(res.body).to.have.property("id");
  });
}
