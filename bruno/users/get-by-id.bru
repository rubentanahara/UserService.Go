meta {
  name: Get User By Id
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/users/{{userId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("returns 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("body id matches userId", function () {
    expect(res.body.id).to.equal(bru.getVar("userId"));
  });
}
