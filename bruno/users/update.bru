meta {
  name: Update User
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/users/{{userId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "username": "jane2",
    "email": "jane2@example.com"
  }
}

tests {
  test("returns 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("username updated", function () {
    expect(res.body.username).to.equal("jane2");
  });
}
