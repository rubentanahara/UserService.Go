meta {
  name: Change Password
  type: http
  seq: 6
}

put {
  url: {{baseUrl}}/users/{{userId}}/password
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "old_password": "password123",
    "new_password": "newpassword456"
  }
}

tests {
  test("returns 204", function () {
    expect(res.getStatus()).to.equal(204);
  });
}
